{
  "name": "@vermithor/api",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b"
  },
  "devDependencies": {
    "@vermithor/config": "workspace:*",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.5",
    "@aws-sdk/client-s3": "^3.975.0",
    "@aws-sdk/s3-presigned-post": "^3.975.0",
    "@aws-sdk/s3-request-presigner": "^3.975.0",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@vermithor/auth": "workspace:*",
    "@vermithor/db": "workspace:*",
    "@vermithor/redis": "workspace:*",
    "ai": "^6.0.48",
    "ai-stream-utils": "^1.4.2",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "elysia": "catalog:",
    "pdf-parse": "^2.4.5",
    "resumable-stream": "^2.2.10",
    "zod": "catalog:"
  }
}
